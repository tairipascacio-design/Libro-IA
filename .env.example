# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional Automated SaaS Billing (Lemon Squeezy OR Stripe Billing)
# Lemon Squeezy (Merchant of Record - Recommended for global autopilot billing)
LEMONSQUEEZY_MONTHLY_URL=""
LEMONSQUEEZY_ANNUAL_URL=""
LEMONSQUEEZY_WEBHOOK_SECRET=""
LEMONSQUEEZY_PORTAL_URL="https://app.lemonsqueezy.com/my-orders"

# Stripe Billing (Alternative)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_MONTHLY=""
STRIPE_PRICE_ANNUAL=""
